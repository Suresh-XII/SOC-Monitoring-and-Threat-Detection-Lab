```spl
`SOC Lab Detection Rule`
`Rule Name: Suspicious PowerShell Script Block Detection`
`Event ID: 4104 (Execute a Remote Command / Script Block)`
`MITRE ATT&CK: T1059.001 (PowerShell), T1027 (Obfuscated Files or Information), T1140 (Deobfuscate/Decode Files)`
`Severity: High (Execution Policy Bypass, Base64, IEX/DownloadString)`
`Data Source: WinEventLog:Microsoft-Windows-PowerShell/Operational | index=blue`
`Description: Analyzes de-obfuscated script blocks for known malicious cmdlets, execution bypass flags, and download cradles.`
```

index=blue EventCode=4104
| eval Script=coalesce(ScriptBlockText,Message)
| where match(Script,"(?i)FromBase64String|EncodedCommand|DownloadString|IEX|Invoke-Expression|ExecutionPolicy Bypass|WindowStyle Hidden")
| eval Detection_Indicator=case(
    match(Script,"(?i)FromBase64String"),"Base64 Decoding",
    match(Script,"(?i)EncodedCommand"),"Encoded PowerShell Command",
    match(Script,"(?i)DownloadString"),"Remote Content Download",
    match(Script,"(?i)IEX|Invoke-Expression"),"Dynamic Code Execution",
    match(Script,"(?i)ExecutionPolicy Bypass"),"Execution Policy Bypass",
    match(Script,"(?i)WindowStyle Hidden"),"Hidden Window Execution",
    true(),"Suspicious PowerShell Activity")
| eval Executing_User=coalesce(user,User,SubjectUserName,"Unknown")
| eval Script_Length=len(Script)
| eval Severity="Requires triage"
| table _time host Executing_User EventCode Detection_Indicator Severity Script_Length Script
| sort - _time
